+@pytest.fixture(scope="module")
+def completed(tmp_path_factory):
+    root = tmp_path_factory.mktemp("proof-controls")
+    initialize(root, "a" * 40)
+    s = TaskService(root)
+    t = s.submit(
+        s.freeze(
+            {
+                "kind": "engineering_pipeline",
