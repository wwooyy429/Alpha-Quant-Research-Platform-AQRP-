+"""Independent arithmetic and real-source counterexamples from GPT Work G2."""
+
+import hashlib
+import json
+import shutil
+from decimal import localcontext
+from fractions import Fraction as Q
+
+import pytest
+
+from aqrp.core.canonical import canonical
+from aqrp.core.contracts import SnapshotRef
+from aqrp.core.errors import ContractError
+from aqrp.experiments.ledger import ExperimentLedger
+from aqrp.portfolio.construct import build_candidate
+from aqrp.portfolio.contracts import load, number, prepare, project, serialized_number
+from aqrp.portfolio.research_input import _engine_parent, bind_research
+from aqrp.portfolio.service import construct_engineering, replay_engineering
+from aqrp.risk.checks import audit_published
+
+from .helpers import fixture, reseal
+from .test_research_input import ORIGINAL, PUBLISHED, bound, projected_payload
+
+OLD_SHA = "18439f31536295aea42e57e566d07cce345a35cf"
+
+
+def large_request(exponent=35, *, price="1", lot="3", short=False):
+    x = fixture()
+    equity = "1e" + str(exponent)
+    x["inputs"]["account"]["data"].update(equity=equity, total_cash=equity)
+    x["policy"]["top_k"] = 1
+    for row in x["inputs"]["prices"]["data"]:
+        row.update(price=price, lot=lot)
+    if short:
+        x["policy"].update(mode="LONG_SHORT", gross="1", net="0")
+        for row in x["inputs"]["permissions"]["data"]:
+            row.update(short_permission=True, borrow_limit_total=equity)
+    return reseal(x)
+
+
+def test_g2_001_lossless_large_target_and_actual_returned_bytes(tmp_path):
+    request = large_request()
+    result = construct_engineering(request, tmp_path, OLD_SHA)
+    data = load(result.raw)
+    assert data["status"] == "SUCCEEDED"
+    target = data["target"]
+    # Hand integer answer: 10**35 % 3 == 1; rounding toward zero leaves cash 1.
+    assert Q(target["quantities"]["SYNTH:A"]) == 10**35 - 1
+    assert Q(target["deltas"]["SYNTH:A"]) == 10**35 - 1
+    assert Q(target["cash"]) == 1
+    assert Q(target["cash"]) + sum(Q(q) for q in target["quantities"].values()) == 10**35
+    stored = load((tmp_path / data["run_id"] / "result.json").read_bytes())
+    assert stored["target"] == target
+    assert data["rebalance_proposals"][0]["delta_qty"] == target["deltas"]["SYNTH:A"]
+
+
+def test_g2_002_consistently_wrong_legal_uuid_not_parent(tmp_path):
+    x = load(bound().raw)
+    x["context"]["snapshot_id"] = "00000000-0000-4000-8000-000000000001"
+    for name, e in x["inputs"].items():
+        for item in e if name == "scores" else [e]:
+            item["context"]["snapshot_id"] = x["context"]["snapshot_id"]
+    result = construct_engineering(reseal(x), tmp_path, OLD_SHA).read()
+    assert result["status"] == "REJECTED"
+    assert "target" not in result
+
+
+@pytest.mark.parametrize(
+    "exponent,price,lot,qty,cash",
+    [
+        (3, "1", "3", str(10**3 - 1), "1"),
+        (34, "1", "3", str(10**34 - 1), "1"),
+        (35, "1", "3", str(10**35 - 1), "1"),
+        (40, "1", "3", str(10**40 - 1), "1"),
+        (35, "0.01", "0.03", str(10**37 - 1) + ".99", "0.0001"),
+        (100, "1e-100", "7", str(10**200 - 2), "0." + "0" * 99 + "2"),
+        (-100, "1e100", "1e-100", "0", "0." + "0" * 99 + "1"),
+    ],
+)
+def test_integer_derived_answers_and_persisted_byte_audit(
+    tmp_path, exponent, price, lot, qty, cash
+):
+    # Independent formula: q = trunc(E / price / lot) * lot; cash = E - q*price.
+    # Constants above are hand/integer derived, never generated by production functions.
+    result = construct_engineering(
+        large_request(exponent, price=price, lot=lot), tmp_path, OLD_SHA
+    ).read()
+    assert result["status"] == "SUCCEEDED", result.get("reasons")
+    target = result["target"]
+    assert target["quantities"]["SYNTH:A"] == qty
+    assert target["cash"] == cash
+    assert Q(qty) / Q(lot) == int(Q(qty) / Q(lot))
+    assert Q(cash) + Q(qty) * Q(price) == Q("1e" + str(exponent))
+    directory = tmp_path / result["run_id"]
+    audit = load((directory / "published-byte-audit.json").read_bytes())
+    assert (
+        audit["result_sha256"]
+        == hashlib.sha256((directory / "result.json").read_bytes()).hexdigest()
+    )
+    assert replay_engineering(tmp_path, result["run_id"])["result"]["target"] == target
+
+
+def test_negative_targets_and_margin_do_not_lose_small_cash(tmp_path):
+    result = construct_engineering(large_request(short=True), tmp_path, OLD_SHA).read()
+    assert result["status"] == "SUCCEEDED", result.get("reasons")
+    q = (10**35 - 4) // 2  # 5e34 % 3 == 2, both long and short truncate to a lot.
+    assert set(result["target"]["quantities"].values()) == {str(q), str(-q)}
+    assert Q(result["target"]["cash"]) == 10**35
+    assert Q(result["target"]["restricted_cash"]) == q
+    assert Q(result["target"]["margin_requirement"]) == q
+    assert Q(result["target"]["free_cash"]) == 4
+
+
+@pytest.mark.parametrize("value", [Q(0), Q(-3, 8), Q(7, 40), Q(10**200 - 2), Q(1, 10**100)])
+def test_finite_output_exact_independent_of_decimal_context(value):
+    with localcontext() as ctx:
+        ctx.prec = 2
+        assert Q(project(value)) == value
+
+
+def test_repeating_ratio_and_input_domain_remain_fixed():
+    assert project(Q(1, 3)) == "0." + "3" * 34
+    assert serialized_number(str(10**35 - 1)) == 10**35 - 1
+    with pytest.raises(ContractError, match="DECIMAL_OUT_OF_DOMAIN"):
+        number(str(10**35 - 1))
+
+
+@pytest.mark.parametrize("value", [None, 1, "NaN", "1/3", "1e35", "1" * 2049])
+def test_output_parser_rejects_noncanonical_or_unbounded(value):
+    with pytest.raises(ContractError):
+        serialized_number(value)
+
+
+@pytest.mark.parametrize(
+    "mutation,code",
+    [
+        ("quantity", "PUBLISHED_QUANTITY_CHANGED"),
+        ("delta", "PUBLISHED_QUANTITY_CHANGED"),
+        ("cash", "PUBLISHED_EQUITY_MISMATCH"),
+        ("free_cash", "PUBLISHED_METRICS_CHANGED"),
+        ("risk", "PUBLISHED_RISK_CHANGED"),
+        ("context", "PUBLISHED_TARGET_CHANGED"),
+        ("scope", "PUBLISHED_TARGET_CHANGED"),
+        ("proposal", "PUBLISHED_DELTA_PROPOSAL_CHANGED"),
+    ],
+)
+def test_actual_serialized_mutation_rejected(tmp_path, mutation, code):
+    request = large_request()
+    result = construct_engineering(request, tmp_path, OLD_SHA).read()
+    if mutation == "quantity":
+        result["target"]["quantities"]["SYNTH:A"] = str(10**35)
+    if mutation == "delta":
+        result["target"]["deltas"]["SYNTH:A"] = "0"
+    if mutation == "cash":
+        result["target"]["cash"] = "2"
+    if mutation == "free_cash":
+        result["target"]["free_cash"] = "2"
+    if mutation == "risk":
+        result["risk"]["passed"] = False
+    if mutation == "context":
+        result["target"]["context"]["snapshot_id"] = "wrong"
+    if mutation == "scope":
+        result["scope"] = "FORMAL"
+    if mutation == "proposal":
+        result["rebalance_proposals"][0]["delta_qty"] = "0"
+    with pytest.raises(ContractError, match=code):
+        audit_published(canonical(result), request, build_candidate(request))
+
+
+def test_service_rejects_serializer_regression_before_publication(tmp_path, monkeypatch):
+    import aqrp.portfolio.service as service
+
+    def broken(value):
+        data = load(canonical(value))
+        if isinstance(data, dict) and "target" in data:
+            data["target"]["quantities"]["SYNTH:A"] = str(10**35)
+        return canonical(data)
+
+    monkeypatch.setattr(service, "canonical", broken)
+    result = service.construct_engineering(large_request(), tmp_path, OLD_SHA).read()
+    assert result["status"] == "REJECTED"
+    assert "target" not in result
+    assert result["reasons"] == ["PUBLISHED_QUANTITY_CHANGED"]
+    assert result["manifest"]["status"] == "FAILED"
+
+
+def test_persisted_corruption_keeps_failure_and_cannot_replay_success(tmp_path, monkeypatch):
+    original = ExperimentLedger.artifact
+
+    def corrupted(self, run_id, name, value):
+        if name == "result.json":
+            value = load(canonical(value))
+            value["target"]["cash"] = "2"
+        return original(self, run_id, name, value)
+
+    monkeypatch.setattr(ExperimentLedger, "artifact", corrupted)
+    with pytest.raises(ContractError, match="PUBLISHED_EQUITY_MISMATCH"):
+        construct_engineering(large_request(), tmp_path, OLD_SHA)
+    run = next(tmp_path.iterdir()).name
+    assert ExperimentLedger(tmp_path).verify(run)["status"] == "FAILED"
+    assert load((tmp_path / run / "result.json").read_bytes())["target"]["cash"] == "2"
+    assert (tmp_path / run / "publication-failure.json").is_file()
+    with pytest.raises(ContractError, match="PUBLICATION_FAILED_NOT_REPLAYABLE"):
+        replay_engineering(tmp_path, run)
+
+
+def test_return_wire_cannot_silently_differ_from_verified_persisted_bytes(tmp_path, monkeypatch):
+    import aqrp.portfolio.service as service
+
+    def broken(value):
+        data = load(canonical(value))
+        if isinstance(data, dict) and "manifest" in data:
+            data["target"]["cash"] = "2"
