+
+
+@pytest.mark.parametrize(
+    "mutation", ["all_ids", "snapshot_hash", "manifest_hash", "missing_binding", "missing_root"]
+)
+def test_p3_actual_parent_not_replaceable_by_consistent_claims(tmp_path, mutation):
